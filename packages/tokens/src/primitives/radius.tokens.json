{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "radius": {
    "$type": "dimension",
    "$description": "Radios de borde de Satella: `md` para controles (--radius), `lg` para tarjetas, `xl` para modales y `full` para píldoras. La marca admin los reduce.",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 10, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "full": {
      "$value": { "value": 999, "unit": "px" },
      "$extensions": { "com.satellatickets.tokens": { "css": { "unit": "px" } } }
    }
  }
}
