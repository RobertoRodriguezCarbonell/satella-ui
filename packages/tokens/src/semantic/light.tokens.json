{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "$description": "Capa semántica del tema claro. El producto de Satella solo tiene tema oscuro: este tema es una propuesta construida con los mismos matices (violeta, ink, mint, ámbar, coral, cian) y verificada con las mismas parejas de contraste. Cada token describe un uso, nunca un valor (ADR-005).",
    "bg": {
      "canvas": { "$value": "{palette.ink.50}", "$description": "Fondo de página." },
      "surface": {
        "$value": "{palette.white}",
        "$description": "Tarjetas, paneles y campos de formulario."
      },
      "elevated": { "$value": "{palette.white}", "$description": "Modales, menús y popovers." },
      "subtle": {
        "$value": "{palette.ink.100}",
        "$description": "Fondos de hover y filas alternas."
      },
      "muted": {
        "$value": "{palette.ink.200}",
        "$description": "Fondos pulsados, seleccionados o de controles deshabilitados."
      },
      "overlay": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5, "hex": "#000000" },
        "$description": "Velo bajo modales y hojas."
      },
      "inverse": {
        "$value": "{palette.ink.900}",
        "$description": "Fondos invertidos: tooltips y toasts."
      }
    },
    "text": {
      "primary": { "$value": "{palette.ink.975}", "$description": "Texto principal." },
      "secondary": { "$value": "{palette.ink.700}", "$description": "Texto de apoyo." },
      "muted": {
        "$value": "{palette.ink.600}",
        "$description": "Placeholders y notas; cumple AA sobre cualquier fondo."
      },
      "disabled": {
        "$value": "{palette.ink.400}",
        "$description": "Texto de controles deshabilitados (sin exigencia de contraste)."
      },
      "inverse": { "$value": "{palette.ink.50}", "$description": "Texto sobre `bg.inverse`." },
      "onPrimary": {
        "$value": "{palette.white}",
        "$description": "Texto sobre `action.primary` en todos sus estados."
      },
      "onDanger": {
        "$value": "{palette.white}",
        "$description": "Texto sobre `action.danger` en todos sus estados."
      },
      "link": { "$value": "{palette.violet.600}", "$description": "Enlaces." }
    },
    "border": {
      "default": {
        "$value": "{palette.ink.200}",
        "$description": "Separadores y bordes decorativos."
      },
      "strong": {
        "$value": "{palette.ink.500}",
        "$description": "Bordes de controles; contraste 3:1 con el fondo."
      },
      "focus": { "$value": "{palette.violet.500}", "$description": "Anillo de foco visible." }
    },
    "action": {
      "primary": { "$value": "{palette.violet.500}", "$description": "Acción principal." },
      "primaryHover": {
        "$value": "{palette.violet.600}",
        "$description": "Acción principal, hover."
      },
      "primaryActive": {
        "$value": "{palette.violet.700}",
        "$description": "Acción principal, pulsada."
      },
      "secondary": {
        "$value": "{palette.ink.100}",
        "$description": "Acción secundaria; el texto es `text.primary`."
      },
      "secondaryHover": {
        "$value": "{palette.ink.200}",
        "$description": "Acción secundaria, hover."
      },
      "secondaryActive": {
        "$value": "{palette.ink.300}",
        "$description": "Acción secundaria, pulsada."
      },
      "danger": { "$value": "{palette.coral.700}", "$description": "Acción destructiva." },
      "dangerHover": {
        "$value": "{palette.coral.800}",
        "$description": "Acción destructiva, hover."
      },
      "dangerActive": {
        "$value": "{palette.coral.900}",
        "$description": "Acción destructiva, pulsada."
      },
      "disabled": {
        "$value": "{palette.ink.100}",
        "$description": "Fondo de acciones deshabilitadas; el texto es `text.disabled`."
      }
    },
    "accent": {
      "bg": {
        "$value": "{palette.violet.100}",
        "$description": "Fondo teñido con el color de marca: chips seleccionados, destacados."
      },
      "text": {
        "$value": "{palette.violet.600}",
        "$description": "Texto e iconos sobre `accent.bg`."
      }
    },
    "feedback": {
      "success": {
        "bg": { "$value": "{palette.mint.100}", "$description": "Fondo de mensajes de éxito." },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.2392, 0.8627, 0.5922],
            "alpha": 0.4,
            "hex": "#3ddc97"
          },
          "$description": "Borde de mensajes de éxito (mint.400 al 40 %)."
        },
        "text": {
          "$value": "{palette.mint.700}",
          "$description": "Texto sobre `feedback.success.bg`."
        },
        "icon": {
          "$value": "{palette.mint.700}",
          "$description": "Icono de éxito; 3:1 sobre `bg.surface` y `feedback.success.bg`."
        }
      },
      "warning": {
        "bg": { "$value": "{palette.amber.100}", "$description": "Fondo de avisos." },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [1, 0.7686, 0.302],
            "alpha": 0.4,
            "hex": "#ffc44d"
          },
          "$description": "Borde de avisos (amber.400 al 40 %)."
        },
        "text": {
          "$value": "{palette.amber.700}",
          "$description": "Texto sobre `feedback.warning.bg`."
        },
        "icon": { "$value": "{palette.amber.700}", "$description": "Icono de aviso." }
      },
      "danger": {
        "bg": { "$value": "{palette.coral.100}", "$description": "Fondo de errores." },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [1, 0.4196, 0.3686],
            "alpha": 0.4,
            "hex": "#ff6b5e"
          },
          "$description": "Borde de errores (coral.400 al 40 %)."
        },
        "text": {
          "$value": "{palette.coral.700}",
          "$description": "Texto sobre `feedback.danger.bg`."
        },
        "icon": { "$value": "{palette.coral.700}", "$description": "Icono de error." }
      },
      "info": {
        "bg": { "$value": "{palette.sky.100}", "$description": "Fondo informativo." },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.298, 0.7882, 0.9412],
            "alpha": 0.4,
            "hex": "#4cc9f0"
          },
          "$description": "Borde informativo (sky.400 al 40 %)."
        },
        "text": {
          "$value": "{palette.sky.700}",
          "$description": "Texto sobre `feedback.info.bg`."
        },
        "icon": { "$value": "{palette.sky.700}", "$description": "Icono informativo." }
      }
    }
  }
}
