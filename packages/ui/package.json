{
  "name": "@satellatickets/ui",
  "version": "0.0.0",
  "description": "Componentes de satella-ui con una sola API para React (web) y React Native",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertoRodriguezCarbonell/satella-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/web/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "react-native": {
          "types": "./dist/native/index.d.ts",
          "default": "./dist/native/index.js"
        },
        "import": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/web/index.js"
        },
        "default": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/web/index.js"
        }
      },
      "./styles.css": "./dist/web/styles.css"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.native.json",
    "lint": "eslint . --max-warnings 0",
    "test:native": "jest"
  },
  "peerDependencies": {
    "react": ">=19.0",
    "react-dom": ">=19.0",
    "react-native": ">=0.81",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "dependencies": {
    "@satellatickets/core": "workspace:*",
    "@satellatickets/tokens": "workspace:*"
  },
  "devDependencies": {
    "@react-native/jest-preset": "catalog:",
    "@satellatickets/eslint-config": "workspace:*",
    "@satellatickets/icons": "workspace:*",
    "@satellatickets/tsconfig": "workspace:*",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "expo": "~56.0.23",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:",
    "storybook": "catalog:",
    "test-renderer": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
