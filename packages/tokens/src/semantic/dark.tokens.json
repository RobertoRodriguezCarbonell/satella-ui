{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "$description": "Capa semántica del tema oscuro: el tema real de Satella (staging.satellatickets.com, variables de :root). Define exactamente los mismos tokens que el tema claro (lo comprueba el test de completitud).",
    "bg": {
      "canvas": { "$value": "{palette.ink.975}" },
      "surface": { "$value": "{palette.ink.950}" },
      "elevated": { "$value": "{palette.ink.950}" },
      "subtle": { "$value": "{palette.ink.900}" },
      "muted": { "$value": "{palette.ink.800}" },
      "overlay": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.6, "hex": "#000000" }
      },
      "inverse": { "$value": "{palette.ink.50}" }
    },
    "text": {
      "primary": { "$value": "{palette.ink.50}" },
      "secondary": { "$value": "{palette.ink.300}" },
      "muted": { "$value": "{palette.ink.400}" },
      "disabled": { "$value": "{palette.ink.500}" },
      "inverse": { "$value": "{palette.ink.975}" },
      "onPrimary": { "$value": "{palette.white}" },
      "onDanger": { "$value": "{palette.ink.975}" },
      "link": { "$value": "{palette.violet.300}" }
    },
    "border": {
      "default": { "$value": "{palette.ink.800}" },
      "strong": { "$value": "{palette.ink.500}" },
      "focus": { "$value": "{palette.violet.500}" }
    },
    "action": {
      "primary": { "$value": "{palette.violet.500}" },
      "primaryHover": { "$value": "{palette.violet.600}" },
      "primaryActive": { "$value": "{palette.violet.700}" },
      "secondary": { "$value": "{palette.ink.900}" },
      "secondaryHover": { "$value": "{palette.ink.800}" },
      "secondaryActive": { "$value": "{palette.ink.700}" },
      "danger": { "$value": "{palette.coral.400}" },
      "dangerHover": { "$value": "{palette.coral.300}" },
      "dangerActive": { "$value": "{palette.coral.200}" },
      "disabled": { "$value": "{palette.ink.900}" }
    },
    "accent": {
      "bg": { "$value": "{palette.violet.950}" },
      "text": { "$value": "{palette.violet.300}" }
    },
    "feedback": {
      "success": {
        "bg": { "$value": "{palette.mint.950}" },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.2392, 0.8627, 0.5922],
            "alpha": 0.4,
            "hex": "#3ddc97"
          }
        },
        "text": { "$value": "{palette.mint.400}" },
        "icon": { "$value": "{palette.mint.400}" }
      },
      "warning": {
        "bg": { "$value": "{palette.amber.950}" },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [1, 0.7686, 0.302],
            "alpha": 0.4,
            "hex": "#ffc44d"
          }
        },
        "text": { "$value": "{palette.amber.400}" },
        "icon": { "$value": "{palette.amber.400}" }
      },
      "danger": {
        "bg": { "$value": "{palette.coral.950}" },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [1, 0.4196, 0.3686],
            "alpha": 0.4,
            "hex": "#ff6b5e"
          }
        },
        "text": { "$value": "{palette.coral.400}" },
        "icon": { "$value": "{palette.coral.400}" }
      },
      "info": {
        "bg": { "$value": "{palette.sky.950}" },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.298, 0.7882, 0.9412],
            "alpha": 0.4,
            "hex": "#4cc9f0"
          }
        },
        "text": { "$value": "{palette.sky.400}" },
        "icon": { "$value": "{palette.sky.400}" }
      }
    }
  }
}
