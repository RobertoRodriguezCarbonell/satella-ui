{
  "name": "@satellatickets/icons",
  "version": "0.0.0",
  "private": true,
  "description": "Iconos de satella-ui (SVG fuente y componentes para web y React Native). Paquete interno: se empaqueta dentro de @satellatickets/ui (ADR-020)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.native.json",
    "lint": "eslint . --max-warnings 0"
  },
  "peerDependencies": {
    "react": ">=19.0",
    "react-native": ">=0.81"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@satellatickets/eslint-config": "workspace:*",
    "@satellatickets/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
