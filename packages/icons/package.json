{
  "name": "@satellatickets/icons",
  "version": "0.0.0",
  "private": true,
  "description": "Iconos de satella-ui: SVG fuente (lucide) y datos de trazos para las vistas web y nativa de Icon. Paquete interno: se empaqueta dentro de @satellatickets/ui (ADR-020, ADR-028)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "node --disable-warning=ExperimentalWarning scripts/generate.ts",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@satellatickets/eslint-config": "workspace:*",
    "@satellatickets/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
