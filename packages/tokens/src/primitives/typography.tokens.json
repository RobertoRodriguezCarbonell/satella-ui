{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "Las fuentes de Satella: Unbounded para titulares, Hanken Grotesk para texto e IBM Plex Mono para etiquetas y código. En nativo la app debe cargar cada fuente con exactamente ese nombre de familia.",
      "display": {
        "$value": ["Unbounded", "Hanken Grotesk", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Titulares y cifras destacadas."
      },
      "sans": {
        "$value": ["Hanken Grotesk", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Texto de interfaz."
      },
      "mono": {
        "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
        "$description": "Etiquetas en mayúsculas, fechas, precios y código."
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Tamaños de fuente (escala de Satella). En web se emiten en rem.",
      "xs": { "$value": { "value": 12, "unit": "px" } },
      "sm": { "$value": { "value": 14, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 18, "unit": "px" } },
      "xl": { "$value": { "value": 20, "unit": "px" } },
      "xxl": { "$value": { "value": 24, "unit": "px" } },
      "xxxl": { "$value": { "value": 30, "unit": "px" } },
      "display": {
        "$value": { "value": 36, "unit": "px" },
        "$description": "Titular de página (h1)."
      },
      "hero": {
        "$value": { "value": 48, "unit": "px" },
        "$description": "Titular de portada y tarjetas destacadas."
      }
    },
    "lineHeight": {
      "$type": "dimension",
      "$description": "Alturas de línea absolutas, emparejadas con `font.size`.",
      "xs": { "$value": { "value": 16, "unit": "px" } },
      "sm": { "$value": { "value": 20, "unit": "px" } },
      "md": { "$value": { "value": 24, "unit": "px" } },
      "lg": { "$value": { "value": 28, "unit": "px" } },
      "xl": { "$value": { "value": 28, "unit": "px" } },
      "xxl": { "$value": { "value": 32, "unit": "px" } },
      "xxxl": { "$value": { "value": 36, "unit": "px" } },
      "display": { "$value": { "value": 40, "unit": "px" } },
      "hero": { "$value": { "value": 48, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    }
  }
}
