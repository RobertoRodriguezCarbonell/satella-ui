{
  "name": "@satellatickets/tokens",
  "version": "0.0.0",
  "description": "Design tokens de satella-ui: primitivos y semánticos en formato DTCG 2025.10 con salidas para web (variables CSS) y React Native",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertoRodriguezCarbonell/satella-ui.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./dist/web/tokens.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tokens.css": "./dist/web/tokens.css"
    }
  },
  "scripts": {
    "build": "pnpm run build:tokens && tsdown",
    "build:tokens": "node --disable-warning=ExperimentalWarning build.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=src build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@satellatickets/eslint-config": "workspace:*",
    "@satellatickets/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "catalog:",
    "style-dictionary": "^5.6.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
