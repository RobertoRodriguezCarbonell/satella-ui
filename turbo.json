{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:native": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "storybook-native#generate": {
      "cache": false
    },
    "storybook-native#lint": {
      "dependsOn": ["^build", "generate"]
    },
    "storybook-native#typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "@satellatickets/tokens#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:web": {
      "dependsOn": ["^build"],
      "env": ["CI", "VISUAL"],
      "passThroughEnv": ["VISUAL_MANIFEST"]
    },
    "test:native": {
      "dependsOn": ["^build"]
    }
  }
}
